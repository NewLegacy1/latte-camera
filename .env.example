# Checkout runs on Ownlane. Defaults in src/lib/ownlane.ts point at the live store.
OWNLANE_CHECKOUT_HOST=https://checkout.dearlatte.shop
SHOPIFY_STORE_DOMAIN=edr0qi-9t.myshopify.com

# Optional overrides for the Shopify variant IDs in src/lib/ownlane.ts (numeric or gid).
SHOPIFY_BLACK_VARIANT_ID=
SHOPIFY_WHITE_VARIANT_ID=
SHOPIFY_GREEN_VARIANT_ID=
SHOPIFY_REFILL_KIT_VARIANT_ID=
SHOPIFY_FREE_FROTHER_VARIANT_ID=
SHOPIFY_FROTHER_VARIANT_ID=
# The custom message card add-on is refused until this is set.
SHOPIFY_CUSTOM_CARD_VARIANT_ID=

# Meta. The pixel id is public. The Conversions API token stays on the server.
# Use the same pixel in Ownlane (Dashboard > Tracking); Ownlane sends InitiateCheckout and Purchase.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Microsoft Clarity project (defaults to the Dear Latte project).
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Optional. Shown on the contact page. Leave blank to point people at their order email.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:43123
