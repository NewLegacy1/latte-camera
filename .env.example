# Shopify. Server only. Never prefix the token with NEXT_PUBLIC.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-01

# Meta. The pixel id is public. The Conversions API token stays on the server.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Optional. Shown on the contact page. Leave blank to point people at their Shopify order email.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:43123
