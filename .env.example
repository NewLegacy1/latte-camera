# Shopify. Server only. Never prefix the token with NEXT_PUBLIC.
SHOPIFY_STORE_DOMAIN=mnhkb0-af.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2025-01

# Ownlane (optional). Leave OFF until the shop is connected in Ownlane Accounts.
# Buy now uses Shopify Storefront carts + BUNDLE2 / BUNDLE3 until then.
OWNLANE_ENABLED=
OWNLANE_CHECKOUT_HOST=https://checkout-platform-two-pay.vercel.app

# Meta. The pixel id is public. The Conversions API token stays on the server.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# Optional. Shown on the contact page. Leave blank to point people at their Shopify order email.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SITE_URL=http://localhost:43123
